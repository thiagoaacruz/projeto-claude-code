{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "starttup|clear|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node\"$CLAUDE_PROJECT_DIR/.claude/hooks/init.js\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/session-stop.js"
                    }
                ]
            }
        ]
    }
}